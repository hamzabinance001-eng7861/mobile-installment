<?xml version="1.0" encoding="utf-8"?>
<!-- Release builds talk HTTPS only. Debug builds (see src/debug) may also use cleartext for a local server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
